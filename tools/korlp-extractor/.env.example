# korlp.org 추출기 설정
# 이 파일을 ".env" 로 복사한 뒤 본인 계정 정보를 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 의해 커밋되지 않습니다. 절대 커밋하지 마세요.

# 필수: 대한이비인후과의사회 회원 계정
KORLP_ID=
KORLP_PW=

# 선택: 추출할 대상 페이지 (미지정 시 기본 게시글 사용)
KORLP_TARGET_URL=https://www.korlp.org/html/?pmode=BBBS0028900025

# 선택: 로그인 페이지 (보통 변경 불필요)
KORLP_LOGIN_URL=https://www.korlp.org/html/?pmode=login

# 선택: 브라우저 창을 보이게 하려면 false (디버깅용). 기본 true(headless).
KORLP_HEADLESS=true

# 선택: 로그인 폼 자동 감지가 실패할 때만 직접 지정하세요.
# 개발자도구(F12)로 input 의 name/id 를 확인해 CSS 셀렉터로 입력합니다.
# 예) KORLP_ID_SELECTOR=input[name='mb_id']
KORLP_ID_SELECTOR=
KORLP_PW_SELECTOR=
KORLP_SUBMIT_SELECTOR=
